# Non-secret settings only. Do not point this staging service at a customer database.
BAYONE_STAGE_DATA_DIR=/var/lib/bayone-vm101-staging
BAYONE_STAGE_PUBLIC_PORT=28795
BAYONE_STAGE_INBOX_PORT=28798
BAYONE_STAGE_MODEL=disabled
# Optional qualification only, after establishing a private SSH forward to the GPU host.
# The inference server runs on the machine that physically owns the GPU.
BAYONE_STAGE_OLLAMA_URL=http://127.0.0.1:11434
BAYONE_STAGE_OLLAMA_MODEL=
